<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <appSettings>
    <!-- Thư mục chứa các tệp dữ liệu .txt (tương đối so với thư mục dự án/ứng dụng) -->
    <add key="DataFolder" value="Data" />
    <!-- Giới hạn tổng tín chỉ được đăng ký trong một học kỳ -->
    <add key="MinTC" value="12" />
    <add key="MaxTC" value="25" />
    <!-- Học kỳ đang thao tác mặc định -->
    <add key="HocKyHienTai" value="HK1" />
    <!-- Ngưỡng điểm trung bình tích lũy để cảnh báo học vụ (phần nâng cao) -->
    <add key="DiemCanhBao" value="1.0" />
    <!-- Điểm trung bình tích lũy tối thiểu để ghi chú "Đạt" trong bảng điểm -->
    <add key="DiemDatYeuCau" value="2.0" />
  </appSettings>
</configuration>
